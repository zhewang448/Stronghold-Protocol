<Window x:Class="StrongholdProtocolLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卫戍协议：盟约 - 服主启动器" Width="1080" Height="820" MinWidth="900" MinHeight="700" Icon="/favicon.ico"
        Background="{StaticResource Bg0}" Foreground="{StaticResource TextHi}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid Margin="26,20,26,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="168" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Grid Width="34" Height="34" Margin="0,0,12,0" AutomationProperties.Name="Stronghold Protocol emblem">
          <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Ellipse Grid.Row="0" Grid.Column="0" Fill="{StaticResource Mint}" /><Ellipse Grid.Row="0" Grid.Column="2" Fill="{StaticResource Mint}" /><Ellipse Grid.Row="0" Grid.Column="4" Fill="{StaticResource Mint}" />
          <Ellipse Grid.Row="1" Grid.Column="0" Fill="{StaticResource Mint}" /><Ellipse Grid.Row="1" Grid.Column="1" Fill="{StaticResource Mint}" /><Ellipse Grid.Row="1" Grid.Column="2" Fill="{StaticResource Mint}" /><Ellipse Grid.Row="1" Grid.Column="3" Fill="{StaticResource Mint}" /><Ellipse Grid.Row="1" Grid.Column="4" Fill="{StaticResource Mint}" />
          <Ellipse Grid.Row="2" Grid.Column="0" Fill="{StaticResource Mint}" /><Ellipse Grid.Row="2" Grid.Column="1" Fill="{StaticResource Mint}" /><Ellipse Grid.Row="2" Grid.Column="2" Fill="{StaticResource Mint}" /><Ellipse Grid.Row="2" Grid.Column="3" Fill="{StaticResource Mint}" /><Ellipse Grid.Row="2" Grid.Column="4" Fill="{StaticResource Mint}" />
          <Ellipse Grid.Row="3" Grid.Column="1" Fill="{StaticResource Mint}" /><Ellipse Grid.Row="3" Grid.Column="2" Fill="{StaticResource Mint}" /><Ellipse Grid.Row="3" Grid.Column="3" Fill="{StaticResource Mint}" />
          <Ellipse Grid.Row="4" Grid.Column="0" Fill="{StaticResource Mint}" /><Ellipse Grid.Row="4" Grid.Column="1" Fill="{StaticResource Mint}" /><Ellipse Grid.Row="4" Grid.Column="2" Fill="{StaticResource Mint}" /><Ellipse Grid.Row="4" Grid.Column="3" Fill="{StaticResource Mint}" /><Ellipse Grid.Row="4" Grid.Column="4" Fill="{StaticResource Mint}" />
        </Grid>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="ProductTitle" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextHi}" />
          <TextBlock x:Name="ProductSubtitle" Margin="0,3,0,0" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextLo}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="BuildVersionText" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource TextDim}" />
        <Button x:Name="BrowseTopButton" Style="{StaticResource SecondaryButton}" Click="BrowseButton_Click" AutomationProperties.Name="Change server directory" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="InstancesLabel" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <ComboBox x:Name="InstanceBox" Grid.Column="1" MinHeight="36" SelectionChanged="InstanceBox_SelectionChanged" AutomationProperties.AutomationId="InstanceSelector"/>
        <Button x:Name="NewInstanceButton" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Click="NewInstanceButton_Click"/>
        <Button x:Name="RemoveInstanceButton" Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="RemoveInstanceButton_Click"/>
        <Button x:Name="DeleteInstanceButton" Grid.Column="4" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="DeleteInstanceButton_Click" AutomationProperties.AutomationId="DeleteInstance"/>
        <Button x:Name="DiscoverInstancesButton" Grid.Column="5" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="DiscoverInstancesButton_Click" AutomationProperties.AutomationId="DiscoverInstances"/>
      </Grid>
      <TextBlock x:Name="ImportHintText" TextWrapping="Wrap" Foreground="{StaticResource TextLo}" FontSize="11" Margin="0,8,0,0"/>
      <StackPanel x:Name="DiscoveryPanel" Visibility="Collapsed" Margin="0,10,0,0">
        <TextBlock x:Name="DiscoveryStatusText" TextWrapping="Wrap" Foreground="{StaticResource TextLo}" Margin="0,0,0,6"/>
        <ListBox x:Name="DiscoveryList" SelectionMode="Multiple" MaxHeight="130" Background="{StaticResource Bg1}" Foreground="{StaticResource TextHi}" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.AutomationId="DiscoveredInstances">
          <ListBox.ItemTemplate><DataTemplate>
            <CheckBox Content="{Binding}" Foreground="{StaticResource TextHi}" Padding="4" IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},Path=IsSelected,Mode=TwoWay}"/>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="ImportDiscoveredButton" Style="{StaticResource SecondaryButton}" Click="ImportDiscoveredButton_Click"/>
          <Button x:Name="CancelDiscoveryButton" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="CancelDiscoveryButton_Click"/>
        </StackPanel>
      </StackPanel>
      <StackPanel x:Name="InstallPanel" Visibility="Collapsed" Margin="0,12,0,0">
        <TextBlock x:Name="InstallHint" TextWrapping="Wrap" Foreground="{StaticResource TextLo}" Margin="0,0,0,8"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="InstallPathBox" Style="{StaticResource InputBox}" AutomationProperties.AutomationId="InstallDirectory"/>
          <Button x:Name="InstallFolderButton" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="InstallFolderButton_Click"/>
          <Button x:Name="InstallButton" Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="InstallButton_Click"/>
        </Grid>
        <ProgressBar x:Name="InstallProgressBar" Height="4" Margin="0,10,0,0" Visibility="Collapsed" Foreground="{StaticResource Mint}"/>
        <DockPanel Margin="0,6,0,0"><Button x:Name="CancelInstallButton" DockPanel.Dock="Right" Visibility="Collapsed" Style="{StaticResource SecondaryButton}" Click="CancelInstallButton_Click"/><TextBlock x:Name="InstallStatusText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextLo}"/></DockPanel>
      </StackPanel>
    </StackPanel>

    <Grid Grid.Row="2" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,16,0">
      <StackPanel>
        <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16,13" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource TextLo}" VerticalAlignment="Center" Margin="1,0,12,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="StatusTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextHi}" />
              <TextBlock x:Name="StatusDetail" Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource TextLo}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock x:Name="StatusBadge" Grid.Column="2" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextLo}" />
          </Grid>
        </Border>

        <TextBlock x:Name="ModeHeading" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextHi}" Margin="2,0,0,9" />
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <RadioButton x:Name="LocalMode" Grid.Column="0" GroupName="HostMode" IsChecked="False" Tag="local" Style="{StaticResource ModeButton}" Checked="Mode_Checked" Margin="0,0,6,0" AutomationProperties.AutomationId="ModeLocal">
            <StackPanel><TextBlock x:Name="LocalModeTitle" FontWeight="SemiBold" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" /><TextBlock x:Name="LocalModeDetail" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource TextLo}" TextWrapping="Wrap" /></StackPanel>
          </RadioButton>
          <RadioButton x:Name="LanMode" Grid.Column="1" GroupName="HostMode" IsChecked="True" Tag="lan" Style="{StaticResource ModeButton}" Checked="Mode_Checked" Margin="3,0" AutomationProperties.AutomationId="ModeLan">
            <StackPanel><TextBlock x:Name="LanModeTitle" FontWeight="SemiBold" /><TextBlock x:Name="LanModeDetail" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource TextLo}" TextWrapping="Wrap" /></StackPanel>
          </RadioButton>
          <RadioButton x:Name="TunnelMode" Grid.Column="2" GroupName="HostMode" IsChecked="False" Tag="tunnel" Style="{StaticResource ModeButton}" Checked="Mode_Checked" Margin="6,0,0,0" AutomationProperties.AutomationId="ModeTunnel">
            <StackPanel><TextBlock x:Name="TunnelModeTitle" FontWeight="SemiBold" /><TextBlock x:Name="TunnelModeDetail" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource TextLo}" TextWrapping="Wrap" /></StackPanel>
          </RadioButton>
        </Grid>

        <Grid Margin="0,0,0,13">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="PortLabel" VerticalAlignment="Center" Margin="2,0,12,0" />
          <TextBox x:Name="PortBox" Grid.Column="1" Text="3000" Style="{StaticResource InputBox}" MaxLength="5" VerticalContentAlignment="Center" PreviewTextInput="PortBox_PreviewTextInput" PreviewKeyDown="PortBox_PreviewKeyDown" TextChanged="PortBox_TextChanged" AutomationProperties.AutomationId="ServerPort" />
          <TextBlock x:Name="RootPathText" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextLo}" AutomationProperties.AutomationId="ServerRoot" />
        </Grid>

        <TextBlock x:Name="ModeHint" Margin="2,0,0,16" FontSize="12" Foreground="{StaticResource TextLo}" TextWrapping="Wrap" />

        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button x:Name="StartButton" Grid.Column="0" Style="{StaticResource PrimaryButton}" Click="StartButton_Click" MinHeight="44" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="StartServer" />
          <Button x:Name="StopButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="StopButton_Click" MinHeight="44" Margin="8,0,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="StopServer" />
          <Button x:Name="CopyPrimaryButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Click="CopyPrimaryButton_Click" MinHeight="44" Margin="8,0,0,0" Visibility="Collapsed" />
        </Grid>

        <Border x:Name="AddressSection" Margin="0,17,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="AddressHeading" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextHi}" Margin="1,0,0,7" />
            <ItemsControl x:Name="AddressList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextLo}" />
                    <TextBlock Grid.Column="1" Text="{Binding Url}" VerticalAlignment="Center" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource Mint}" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Tag="{Binding Url}" Click="OpenAddress_Click" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="8,0,0,0" ToolTip="Open address in browser" AutomationProperties.Name="Open address">
                      <Path Width="12" Height="12" Stroke="{StaticResource Mint}" StrokeThickness="1.5" Data="M2,10 L10,2 M4,2 H10 V8" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="OpenGameButton" Style="{StaticResource SecondaryButton}" Click="OpenGameButton_Click" />
              <Button x:Name="OpenConsoleButton" Style="{StaticResource SecondaryButton}" Click="OpenConsoleButton_Click" Margin="8,0,0,0" />
              <Button x:Name="RestartButton" Style="{StaticResource SecondaryButton}" Click="RestartButton_Click" Margin="8,0,0,0" AutomationProperties.AutomationId="RestartServer" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="ChecksHeading" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextHi}" Margin="2,0,0,9" />
        <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="15,7">
          <StackPanel>
            <Grid Margin="0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="ProjectCheckLabel" /><TextBlock x:Name="ProjectCheckValue" Grid.Column="1" Foreground="{StaticResource TextLo}" /></Grid>
            <Border Height="1" Background="{StaticResource Line}" />
            <Grid Margin="0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="NodeCheckLabel" /><TextBlock x:Name="NodeCheckValue" Grid.Column="1" Foreground="{StaticResource TextLo}" /></Grid>
            <Border Height="1" Background="{StaticResource Line}" />
            <Grid Margin="0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="DepsCheckLabel" /><TextBlock x:Name="DepsCheckValue" Grid.Column="1" Foreground="{StaticResource TextLo}" /></Grid>
            <Border Height="1" Background="{StaticResource Line}" />
            <Grid Margin="0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="PortCheckLabel" /><TextBlock x:Name="PortCheckValue" Grid.Column="1" Foreground="{StaticResource TextLo}" /></Grid>
            <Border Height="1" Background="{StaticResource Line}" />
            <Grid Margin="0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="AssetsCheckLabel" /><TextBlock x:Name="AssetsCheckValue" Grid.Column="1" Foreground="{StaticResource TextLo}" /></Grid>
            <Border Height="1" Background="{StaticResource Line}" />
            <Grid Margin="0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="TunnelCheckLabel" /><TextBlock x:Name="TunnelCheckValue" Grid.Column="1" Foreground="{StaticResource TextLo}" /></Grid>
          </StackPanel>
        </Border>

        <Button x:Name="InstallNodeButton" Style="{StaticResource SecondaryButton}" Click="InstallNodeButton_Click" HorizontalAlignment="Stretch" Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="InstallNode" />
        <Button x:Name="InstallTunnelButton" Style="{StaticResource SecondaryButton}" Click="InstallTunnelButton_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0" Visibility="Collapsed" />
        <Button x:Name="RefreshButton" Style="{StaticResource SecondaryButton}" Click="RefreshButton_Click" Margin="0,12,0,0" />

        <Border Margin="0,17,0,0" Padding="14,12" Background="#101815" BorderBrush="#285344" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="FirstRunTitle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MintHi}" />
            <TextBlock x:Name="FirstRunDetail" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextMd}" TextWrapping="Wrap" LineHeight="17" />
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="3" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,9">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel LastChildFill="True" Margin="1,0,1,7">
          <Button x:Name="CopyLogButton" DockPanel.Dock="Right" Click="CopyLogButton_Click" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="8,0,0,0" FontSize="11" />
          <Button x:Name="OpenLogButton" DockPanel.Dock="Right" Click="OpenLogButton_Click" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="8,0,0,0" FontSize="11" />
          <TextBlock x:Name="LogHeading" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextHi}" />
          <TextBlock x:Name="LogPathText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBox x:Name="LogBox" Grid.Row="1" Background="{StaticResource Bg0}" Foreground="{StaticResource TextLo}" BorderBrush="{StaticResource Line}" BorderThickness="0" FontFamily="Consolas" FontSize="11" Padding="8,6" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.AutomationId="LaunchLog" />
      </Grid>
    </Border>
  </Grid>
</Window>

# --- dependencies & generated client libs -------------------------------------------------------
node_modules/
# a local npm cache (npm_config_cache=./.npm-cache, npm ci --cache .npm-cache — GitHub #258)
.npm-cache/
# copied from node_modules by tools/vendor.mjs (postinstall); never commit third-party builds
public/vendor/

# --- game assets: (c) Hypergryph / Yostar, fetched or extracted locally, NEVER committed ----------
# tools/fetch-assets.mjs → public/assets/** (~270 MB) and public/fonts/** (+ fonts.css)
public/assets/
public/fonts/
# tools/local-extract/extract.py → public/assets/local/** and this per-machine manifest
# (optional: the client and the tests work without it; docs/DEPLOY.md §6 lists what falls back)
# Battlefield scenes (0.2.5): extracted files live under public/assets/local/scene/ (already ignored by
# public/assets/ above). Downloaded bundles live in .cache/official-scenes/ (already ignored by .cache/ below).
# The repository never stores those official files.
data/local-assets.json
data/resource-manifest.json
# tools/local-extract/fx.py → the official battle effects' file list (DESIGN §33; the files under public/assets/local/fx/)
data/local-fx.json
# download caches, upstream tables, ledgers, reports, setup state
.cache/
# a worktree that links these folders instead of holding them: git sees a symlink as a file, which the patterns
# above (trailing slash: directories only) do not match
/node_modules
/public/vendor
/public/assets
/public/fonts
/.cache

# --- Python (optional local-client extraction) ----------------------------------------------------
.venv*/
venv/
__pycache__/
*.py[cod]

# --- content packs (docs/PACKS.md): the pack index for a static host, generated by `node tools/packs.mjs index`
# (the server answers /packs/index.json itself; tools/package.mjs writes this file into the release zips) -----------
packs/index.json

# --- plugins (docs/PLUGINS.md): a server's own plugins and its policy file live in plugins/ and are never committed;
# only the folder's readme, its guide for AI agents (AGENTS.md) and the templates (plugins/_template/, from P1) are tracked — and
# so ship (tools/package.mjs); plugins/_dist/ (packed zips) and plugins/_moved/ (files the studio moved out) stay ignored
plugins/*
!plugins/README.md
!plugins/AGENTS.md
!plugins/_template/

# --- tests & logs ----------------------------------------------------------------------------------
test/e2e/out/
# Local interface review screenshots and reports.
.impeccable/
logs/
*.log

# --- per-machine config (scripts/install-service-windows.ps1) ------------------------------------
scripts/service.env.cmd
.env
.env.*

# --- private local state: never publish match exports, credentials or machine profiles -----------
/private/
/local/
/secrets/
/handoff/
.codex/
.ssh/
.cloudflared/
.bash_history
.zsh_history
.python_history
.git-credentials
.npmrc
*.pem
*.key
*.p12
*.pfx
frpc*.toml
frpc*.ini
frpc*.json
frps*.toml
frps*.ini
frps*.json
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.har
browser-profile/
chrome-profile/
playwright/.auth/
stronghold-stats-*.json
stronghold-loadout-*.json
stronghold-ownership-*.json
stronghold-diy-*.json
# Reviewed templates may be tracked; they must contain placeholders only.
!.env.example
!.env.*.example

# --- OS / editor clutter ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.lnk
*.url
*.swp
.idea/
.vscode/
.claude/
# tools/sim-check.mjs: the corpus and its Node traces for /dev/sim-check.html
public/dev/simcheck/data/

# --- generated test, build & release output ------------------------------------------------------
# Test coverage and compiler caches are local diagnostics, never source files.
coverage/
.nyc_output/
*.tsbuildinfo
.eslintcache

# Keep release archives and checksums outside the tracked source tree. The package tool accepts
# an external --out directory, but these guards prevent an accidental in-tree build from being
# staged or included in a source snapshot.
/release/
/dist/
/artifacts/
/out/
/launcher/bin/
/launcher/obj/
/StrongholdProtocolLauncher.exe
/SHA256SUMS.txt
/SHA256SUMS.txt.sig
*.zip

# Temporary handoff notes written during local UI work; durable documentation lives under
# docs/LOCAL-DEV.md and the release candidate notes.
/docs/MOBILE-HUD-FIX.md

# Common package-manager and crash diagnostics.
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Machine-local CDN credentials and generated transport packs
config/r2-sync.json
public/resource-packs/
data/resource-packs.json

# Native launcher test build outputs
test/launcher-native/bin/
test/launcher-native/obj/
